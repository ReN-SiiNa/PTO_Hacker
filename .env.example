# Copy to .env and fill in. .env is gitignored -- never commit it.

# ---------------------------------------------------------------- scheduling
# The worker schedules by LOCAL hour; a container defaults to UTC without this.
TZ=Asia/Kolkata

# ------------------------------------------------------------ notifications
# console (default, prints to the log) | telegram | none
PTOHACKER_NOTIFY=telegram

# Telegram setup:
#   1. message @BotFather -> /newbot -> copy the token
#   2. send your new bot any message (bots cannot start conversations)
#   3. open https://api.telegram.org/bot<TOKEN>/getUpdates
#      and read result[0].message.chat.id
PTOHACKER_TELEGRAM_TOKEN=
PTOHACKER_TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------- fares
# mock (default, synthetic, offline) | google (real prices, scraped)
#
# "google" uses fast-flights to scrape Google Flights. It is not an API:
# against Google's ToS, blocked more often from datacenter IPs than home ones,
# and it breaks when the page format changes. Opt in knowingly.
PTOHACKER_FARES=mock

# Hour of day the fare check runs (0-23, local time).
PTOHACKER_FARES_HOUR=6

# --------------------------------------------------- public deployment only
# Needed for: docker compose --profile public up -d
# A domain whose DNS A record already points at this server.
PTO_DOMAIN=pto.example.com
PTO_USER=me
# Generate with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'yourpassword'
PTO_PASSWORD_HASH=
